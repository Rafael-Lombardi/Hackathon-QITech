APP_ENV=local
SERVICE_NAME=bootcamp-api
DATABASE_URL=postgresql+psycopg2://bootcamp:bootcamp@localhost:5432/bootcamp
INTERNAL_TOKEN=default_token
SERVER_LOCALHOST=0.0.0.0

# O DICT (o mock dele, servico dict-mock do docker-compose.yml): quem diz
# o trust factor do recebedor. Esta URL vale pra quem roda a API direto
# na maquina, com o mock de pe no Docker. Dentro do compose o endereco e
# sempre http://dict-mock:1080, e esta linha nao chega la.
DICT_API_URL=http://localhost:1080
# Segundos de espera, maior que zero. Estourou, a camada 3 sai
# "unavailable" e o Pix e decidido sem ela.
DICT_API_TIMEOUT=2
# O token que o DICT exige de nos: o INTERNAL_TOKEN na outra direcao.
# La conferimos quem nos chama; aqui nos apresentamos pra quem chamamos.
# O mock aceita qualquer um.
DICT_API_INTERNAL_TOKEN=default_token

# API_PORT=3001
# DB_PORT=5433
# Porta do mock na sua maquina. Mudou aqui, mude tambem a porta da
# DICT_API_URL acima.
# DICT_MOCK_PORT=1081
