APP_ENV=local
SERVICE_NAME=bootcamp-api
DATABASE_URL=postgresql+psycopg2://bootcamp:bootcamp@localhost:5432/bootcamp
INTERNAL_TOKEN=default_token
SERVER_LOCALHOST=0.0.0.0

# Os enderecos das tres fontes (DICT, cadastro de aparelhos, restricoes)
# pra quem roda a API fora do Docker: estas linhas nao chegam no
# container. As tres apontam pro mesmo mock.
DICT_API_URL=http://localhost:1080
DEVICE_REGISTRY_URL=http://localhost:1080
RESTRICTIONS_URL=http://localhost:1080
# Segundos, maior que zero; vale pra cada fonte.
SOURCES_TIMEOUT=2
SOURCES_INTERNAL_TOKEN=default_token

# API_PORT=3001
# DB_PORT=5433
# Porta do mock na sua maquina. Mudou aqui, mude tambem a porta das
# tres URLs acima.
# DICT_MOCK_PORT=1081
