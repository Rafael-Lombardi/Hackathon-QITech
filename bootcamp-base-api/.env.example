APP_ENV=local
SERVICE_NAME=bootcamp-api
DATABASE_URL=postgresql+psycopg2://bootcamp:bootcamp@localhost:5432/bootcamp
INTERNAL_TOKEN=default_token
SERVER_LOCALHOST=0.0.0.0

# O endereco do DICT pra quem roda a API fora do Docker: esta linha nao
# chega no container.
DICT_API_URL=http://localhost:1080
# Segundos, maior que zero.
DICT_API_TIMEOUT=2
DICT_API_INTERNAL_TOKEN=default_token

# API_PORT=3001
# DB_PORT=5433
# Porta do mock na sua maquina. Mudou aqui, mude tambem a porta da
# DICT_API_URL acima.
# DICT_MOCK_PORT=1081
